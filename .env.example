# Copy to `.env` for local development and adjust as needed.

# The shared key required at /admin.
ADMIN_KEY=cig-finance-2026

# Signing secret for issued session tokens. If unset, defaults to
# ADMIN_KEY + "::sign" — set an unrelated value in production.
JWT_SECRET=change-me-in-production

# How long an issued admin session-token stays valid, in minutes. 30 is a
# reasonable default for a shared key on an internal tool.
TOKEN_TTL_MINUTES=30

# Ceiling for a single upload (Excel file).
MAX_UPLOAD_MB=50

# Ceiling for a single pipeline run.
PIPELINE_TIMEOUT_S=60

# Port for local development. Railway / Render override this at runtime.
PORT=8000
